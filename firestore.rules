rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsShop(shopId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in ['sales', 'expenses', 'staff', 'attendance', 'inventory']
        && ownsShop(resource.data.shopId);
      allow create, update: if collectionName in ['sales', 'expenses', 'staff', 'attendance', 'inventory']
        && ownsShop(request.resource.data.shopId);
      allow delete: if collectionName in ['sales', 'expenses', 'staff', 'attendance', 'inventory']
        && ownsShop(resource.data.shopId);
    }
  }
}
